# Build context: minikb repo root (needs packages/ui + packages/chat + web).
# CN-friendly base + npm registry for Volcengine / Aliyun hosts.
FROM docker.m.daocloud.io/library/node:22-bookworm-slim AS deps
WORKDIR /repo
ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
COPY packages/ui ./packages/ui
RUN npm ci --prefix packages/ui
COPY packages/chat ./packages/chat
RUN npm ci --prefix packages/chat
COPY web/package.json web/package-lock.json ./web/
RUN npm ci --prefix web

FROM docker.m.daocloud.io/library/node:22-bookworm-slim AS builder
WORKDIR /repo
ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /repo/packages/ui ./packages/ui
COPY --from=deps /repo/packages/chat ./packages/chat
COPY --from=deps /repo/web/node_modules ./web/node_modules
COPY web ./web
WORKDIR /repo/web
RUN npm run build

FROM docker.m.daocloud.io/library/node:22-bookworm-slim AS runner
WORKDIR /repo
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=builder /repo/web/public ./web/public
COPY --from=builder /repo/web/.next/standalone ./
COPY --from=builder /repo/web/.next/static ./web/.next/static
EXPOSE 3000
CMD ["node", "web/server.js"]
