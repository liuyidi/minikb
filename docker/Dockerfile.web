# syntax=docker/dockerfile:1.7
# Build context: minikb repo root (needs packages/ui + web).
FROM node:22-bookworm-slim AS deps
WORKDIR /repo
COPY packages/ui ./packages/ui
COPY web/package.json web/package-lock.json ./web/
WORKDIR /repo/web
RUN npm ci

FROM node:22-bookworm-slim AS builder
WORKDIR /repo
COPY --from=deps /repo/packages/ui ./packages/ui
COPY --from=deps /repo/web/node_modules ./web/node_modules
COPY web ./web
WORKDIR /repo/web
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-bookworm-slim AS runner
WORKDIR /repo
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=builder /repo/web/public ./web/public
COPY --from=builder /repo/web/.next/standalone ./
COPY --from=builder /repo/web/.next/static ./web/.next/static
EXPOSE 3000
CMD ["node", "web/server.js"]
