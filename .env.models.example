# Platform model slots (secrets). Copy to .env.models and fill keys.
# Convention per slot:
#   MINIKB_{SLOT}_API_KEY=
#   MINIKB_{SLOT}_BASE_URL=
#   MINIKB_{SLOT}_MODEL=
#   MINIKB_{SLOT}_RERANK_MODEL=   # optional rerank override
#
# Slots: openai | deepseek_pro | qwen | glm | kimi | minimax | doubao
# Mirrors minibot ``minibot/.env.models.example``.

# DeepSeek Flash (legacy openai slot)
# MINIKB_OPENAI_API_KEY=
# MINIKB_OPENAI_BASE_URL=https://api.deepseek.com/v1
# MINIKB_OPENAI_MODEL=deepseek-v4-flash
# MINIKB_MODEL=deepseek-v4-flash

# DeepSeek Pro
# MINIKB_DEEPSEEK_PRO_API_KEY=
# MINIKB_DEEPSEEK_PRO_BASE_URL=https://api.deepseek.com/v1
# MINIKB_DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Qwen (OpenAI-compat + rerank via /v1/rerank)
# MINIKB_QWEN_API_KEY=
# MINIKB_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MINIKB_QWEN_MODEL=qwen3.7-plus
# MINIKB_QWEN_RERANK_MODEL=gte-rerank-v2

# GLM
# MINIKB_GLM_API_KEY=
# MINIKB_GLM_BASE_URL=
# MINIKB_GLM_MODEL=glm-5.2

# Kimi
# MINIKB_KIMI_API_KEY=
# MINIKB_KIMI_BASE_URL=
# MINIKB_KIMI_MODEL=kimi-k2.7-code

# MiniMax
# MINIKB_MINIMAX_API_KEY=
# MINIKB_MINIMAX_BASE_URL=
# MINIKB_MINIMAX_MODEL=minimax-m3

# Doubao (Anthropic Messages API — QA LLM only, not rerank)
# MINIKB_DOUBAO_API_KEY=
# MINIKB_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
# MINIKB_DOUBAO_MODEL=doubao-seed-2.0-lite

# --- Rerank defaults ---
# MINIKB_RERANK_DEFAULT_PROVIDER=qwen
# MINIKB_RERANK_DEFAULT_MODEL=gte-rerank-v2
# MINIKB_LLM_DEFAULT_SLOT=openai

# Optional dedicated Cohere rerank slot
# MINIKB_COHERE_API_KEY=
# MINIKB_COHERE_BASE_URL=https://api.cohere.ai
# MINIKB_COHERE_RERANK_MODEL=rerank-multilingual-v3.0
