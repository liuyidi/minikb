{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@minikb/chat/*": ["./*"],
      "@minikb/ui/*": ["../ui/*"]
    }
  },
  "include": ["types/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", "stories", "components"]
}
