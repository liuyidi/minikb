# minikb 环境变量样例。复制为 .env 后按需修改。
# 所有键都可加 MINIKB_ 前缀，pydantic-settings 会自动匹配。

MINIKB_ENV=dev
MINIKB_HOST=127.0.0.1
MINIKB_PORT=8080
MINIKB_LOG_LEVEL=INFO

# --- Postgres ---
MINIKB_POSTGRES_DSN=postgresql+psycopg://minikb:minikb@127.0.0.1:5432/minikb

# --- Redis / RQ ---
MINIKB_REDIS_URL=redis://127.0.0.1:6379/0

# --- MinIO / S3 ---
MINIKB_S3_ENDPOINT=127.0.0.1:9000
MINIKB_S3_ACCESS_KEY=minioadmin
MINIKB_S3_SECRET_KEY=minioadmin
MINIKB_S3_BUCKET=minikb
MINIKB_S3_SECURE=false
MINIKB_S3_REGION=us-east-1

# --- Embedding / LLM ---
MINIKB_OPENAI_API_KEY=
MINIKB_OPENAI_BASE_URL=https://api.openai.com/v1
MINIKB_EMBEDDING_MODEL=text-embedding-3-small
MINIKB_EMBEDDING_DIM=1536

# --- Auth ---
MINIKB_DEFAULT_ORG_SLUG=default
MINIKB_REQUIRE_API_KEY=false

# --- Ingest ---
MINIKB_INGEST_QUEUE_DEFAULT=cpu
MINIKB_INGEST_QUEUE_EMBED=embed
MINIKB_MAX_UPLOAD_MB=100
