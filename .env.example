# Production environment for docker/docker-compose.prod.yml.
# Copy this file to /opt/minikb/.env. App images are built on the host
# (minikb:local / minikb-web:local); do not set MINIKB_IMAGE / MINIKB_WEB_IMAGE.

# --- Application ---
MINIKB_ENV=prod
MINIKB_HOST=0.0.0.0
MINIKB_PORT=8080
MINIKB_LOG_LEVEL=INFO
MINIKB_WEB_WORKERS=2
MINIKB_INGEST_CONCURRENCY=4

# --- Postgres ---
MINIKB_POSTGRES_USER=minikb
MINIKB_POSTGRES_PASSWORD=minikb
MINIKB_POSTGRES_DB=minikb
MINIKB_POSTGRES_PORT=5432

# --- Redis ---
MINIKB_REDIS_PORT=6379

# --- MinIO / S3 ---
MINIKB_S3_ACCESS_KEY=minioadmin
MINIKB_S3_SECRET_KEY=minioadmin
MINIKB_S3_BUCKET=minikb
MINIKB_S3_PORT=9000
MINIKB_MINIO_CONSOLE_PORT=9001

# --- OpenAI / Embeddings ---
MINIKB_OPENAI_API_KEY=
MINIKB_OPENAI_BASE_URL=https://api.openai.com/v1
MINIKB_EMBEDDING_MODEL=text-embedding-3-small
MINIKB_EMBEDDING_DIM=1536

# --- Application defaults ---
MINIKB_DEFAULT_ORG_SLUG=default
MINIKB_REQUIRE_API_KEY=true
MINIKB_MAX_UPLOAD_MB=100

# Must match mini-auth JWT_SECRET (HS256).
MINIKB_JWT_SECRET=
MINIKB_JWT_ISSUER=https://auth.liuyidi.me
MINIKB_JWT_AUDIENCE=mini-auth

# Next frontend (OIDC)
MINIAUTH_ISSUER=https://auth.liuyidi.me
MINIAUTH_CLIENT_ID=minikb
MINIAUTH_REDIRECT_URI=https://kb.liuyidi.me/login/callback
MINIKB_PUBLIC_ORIGIN=https://kb.liuyidi.me
MINIKB_SESSION_SECRET=

# --- Optional monitoring profile ---
MINIKB_PROMETHEUS_PORT=9090
